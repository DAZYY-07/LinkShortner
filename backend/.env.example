# Database. Leave unset locally to use SQLite (./links.db); set to Postgres in production.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email: Brevo's HTTPS API is used when BREVO_API_KEY is set (works on Render's free tier).
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=LinkShortener <you@example.com>

# SMTP fallback, used when BREVO_API_KEY is not set.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=LinkShortener <no-reply@example.com>

# Public URLs used in verification emails and post-verification redirects.
BACKEND_URL=https://your-backend.example.com
FRONTEND_URL=https://your-frontend.example.com

# Local development examples:
# BACKEND_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:5173
