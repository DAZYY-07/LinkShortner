# Database. Leave unset locally to use SQLite (./links.db); set to Postgres in production.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email: the Gmail Apps Script (backend/gmail_sender.gs) is used when both are set.
# Free, and works on Render's free tier, which blocks SMTP. See EMAIL_VERIFICATION.md.
GMAIL_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
GMAIL_SCRIPT_SECRET=same-value-as-the-script-SECRET-property
EMAIL_FROM=LinkShortener <you@gmail.com>

# SMTP fallback, used when the Gmail script is not configured.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=LinkShortener <no-reply@example.com>

# Public URLs used in verification emails and post-verification redirects.
BACKEND_URL=https://your-backend.example.com
FRONTEND_URL=https://your-frontend.example.com

# Local development examples:
# BACKEND_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:5173
