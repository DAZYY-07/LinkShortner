# Settings for docker compose. Copy to .env (next to docker-compose.yml) to change them;
# every value has a working default, so this file is optional.

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8001
DB_PORT=5433

# Postgres credentials (also used to connect from pgAdmin / DBeaver)
POSTGRES_DB=linksnip
POSTGRES_USER=linksnip
POSTGRES_PASSWORD=linksnip

# Guests may create this many links before they are asked to sign in
GUEST_LINK_LIMIT=5

# Optional: refuse unsafe websites using Google Safe Browsing (free key from Google Cloud)
SAFE_BROWSING_API_KEY=

# Optional: send real emails through the Gmail Apps Script (backend/gmail_sender.gs).
# Without these, verification and reset links are printed in `docker compose logs backend`.
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=
EMAIL_FROM=LinkShortener <you@gmail.com>
